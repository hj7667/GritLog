@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GritLog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="gl-nav">
        <div class="container gl-nav-inner">
            <a class="gl-brand" asp-controller="Habit" asp-action="Index">
                <span class="gl-brand-mark">G</span>
                <span class="gl-brand-text">GritLog</span>
            </a>
            <nav class="gl-links">
                <a class="gl-link @(action == "Index" ? "active" : "")" asp-controller="Habit" asp-action="Index">대시보드</a>
                <a class="gl-link @(action == "Manage" ? "active" : "")" asp-controller="Habit" asp-action="Manage">습관 관리</a>
                <a class="gl-link @(action == "Stats" ? "active" : "")" asp-controller="Habit" asp-action="Stats">통계</a>
            </nav>
        </div>
    </header>

    <main class="container gl-page">
        @RenderBody()
    </main>

    <footer class="gl-footer">GritLog · 매일 조금씩</footer>

    <partial name="_HabitFormModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/gritlog.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
